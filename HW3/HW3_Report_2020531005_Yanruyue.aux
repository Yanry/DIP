\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces four-quadrant size limit 4*4}}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces number of cluster number is 100}}{4}{}\protected@file@percent }
